[Unit]
Description=Daniel loop
After=network-online.target docker.service daniel-body.service
Wants=network-online.target daniel-body.service
Requires=docker.service

[Service]
User=daniel-mind
SupplementaryGroups=docker
# The official tool is installed inside the mind account.
Environment=PATH=/var/lib/daniel/mind/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/daniel/daniel.env
ExecStart=/usr/bin/python3 /opt/daniel/daniel_loop.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
