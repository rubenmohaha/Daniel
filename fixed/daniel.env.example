# Configuration of the loop, installed as /etc/daniel/daniel.env.

# Exact model version, pinned at setup so that the mind stays fixed.
# Write the full identifier of a version, not an alias that may change.
DANIEL_MODEL=

DANIEL_CONTAINER=daniel-body
DANIEL_STATE_DIR=/var/lib/daniel/mind

# The page on which a human follows Daniel, served on the local network.
DANIEL_VIEW_PORT=8642
